      "source": [
        "from vllm import SamplingParams\n",
        "\n",
        "# Define the formatting function for MedQA\n",
        "def prepare_prompt_and_target(example):\n",
        "    question = example.get('question', 'Unknown Question')\n",
        "    options = example.get('options', {})\n",
        "    expected_answer = str(example.get('answer_idx', ''))\n",
        "\n",
        "    prompt = f\"Question: {question}\\nChoices:\\n\"\n",
        "\n",
        "    if isinstance(options, dict):\n",
        "        for key, value in options.items():\n",
        "            if value: # Ignore null options\n",
        "                prompt += f\"{key}: {value}\\n\"\n",
        "\n",
        "    prompt += \"\\nAnswer directly with the correct choice ID:\"\n",
        "    return prompt, expected_answer\n",
        "\n",
        "# Evaluate parameters (Greedy decoding for evaluation)\n",
        "eval_sampling_params = SamplingParams(temperature=0.0, max_tokens=15)\n",
        "sample_size = len(data) # Evaluate the full dataset\n",
        "\n",
        "print(f\"Starting Zero-Shot Evaluation on {sample_size} samples...\\n\")\n",
        "\n",
        "# Take a sample\n",
        "eval_data = data[:sample_size]\n",
        "\n",
        "# Prepare prompts and targets\n",
        "prompts_and_targets = [prepare_prompt_and_target(ex) for ex in eval_data]\n",
        "prompts = [pt[0] for pt in prompts_and_targets]\n",
        "expected_answers = [pt[1] for pt in prompts_and_targets]\n",
        "\n",
        "# Generate responses\n",
        "eval_outputs = llm.generate(prompts, eval_sampling_params, use_tqdm=True)\n",
        "\n",
        "# Calculate accuracy\n",
        "correct = 0\n",
        "for i, output in enumerate(eval_outputs):\n",
        "    generated_text = output.outputs[0].text.strip()\n",
        "    expected = expected_answers[i]\n",
        "\n",
        "    # Basic check: verify if the expected ID is clearly in the generated response\n",
        "    if expected and expected in generated_text:\n",
        "        correct += 1\n",
        "\n",
        "accuracy = (correct / len(eval_data)) * 100\n",
        "print(f\"\\nTest Sample Accuracy: {correct}/{len(eval_data)} ({accuracy:.1f}%)\")"
      ],
