      },
      "source": [
        "## Define Task-Specific Prompts\n",
        "\n",
        "### Subtask:\n",
        "Create specific prompt formatting functions tailored to different dataset formats like Multiple Choice Questions and Text Generation.\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "080e12ca"
      },
      "source": [
        "**Reasoning**:\n",
        "Define prompt formatting functions for different task types (MCQ and Generation) and test them with dummy data.\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "782b44fd",
        "outputId": "2abfd10d-2dd6-48ad-9d67-2d2730cbe8a6"
      },
      "source": [
        "def format_mcq_prompt(example):\n",
        "    question = example.get('question', '')\n",
        "    options = example.get('options', {})\n",
        "    prompt = f\"Question: {question}\\nChoices:\\n\"\n",
        "    if isinstance(options, dict):\n",
        "        for key, value in options.items():\n",
        "            if value:\n",
        "                prompt += f\"{key}: {value}\\n\"\n",
        "    elif isinstance(options, list):\n",
        "        for i, opt in enumerate(options):\n",
        "            prompt += f\"{chr(65+i)}: {opt}\\n\"\n",
        "    prompt += \"\\nAnswer directly with the correct choice ID:\"\n",
        "    return prompt\n",
        "\n",
        "def format_generation_prompt(example):\n",
        "    context = example.get('context', '')\n",
        "    question = example.get('question', '')\n",
        "    prompt = \"\"\n",
        "    if context:\n",
        "        prompt += f\"Context: {context}\\n\"\n",
        "    prompt += f\"Task: {question}\\n\\nResponse:\"\n",
        "    return prompt\n",
        "\n",
        "# Dummy testing\n",
        "mcq_dummy = {\n",
        "    'question': 'What is the powerhouse of the cell?',\n",
        "    'options': {'A': 'Nucleus', 'B': 'Mitochondria', 'C': 'Ribosome'}\n",
        "}\n",
        "gen_dummy = {\n",
        "    'question': 'Summarize the patient\\'s history.',\n",
        "    'context': 'Patient is a 45yo male presenting with...'\n",
        "}\n",
        "\n",
        "print(\"MCQ Prompt:\\n\", format_mcq_prompt(mcq_dummy))\n",
        "print(\"\\nGeneration Prompt:\\n\", format_generation_prompt(gen_dummy))\n"
      ],
      "execution_count": 5,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "MCQ Prompt:\n",
            " Question: What is the powerhouse of the cell?\n",
            "Choices:\n",
            "A: Nucleus\n",
            "B: Mitochondria\n",
            "C: Ribosome\n",
            "\n",
            "Answer directly with the correct choice ID:\n",
            "\n",
            "Generation Prompt:\n",
            " Context: Patient is a 45yo male presenting with...\n",
            "Task: Summarize the patient's history.\n",
            "\n",
            "Response:\n"
          ]
        }
      ]
    },
