      "source": [
        "#!pip install vllm -q\n",
        "import pandas as pd\n",
        "import json\n",
        "from tqdm.auto import tqdm\n",
        "from vllm import SamplingParams\n",
        "import numpy as np\n",
        "import os\n",
        "import re\n",
        "\n",
        "# Configuration\n",
        "results_list = []\n",
        "\n",
        "# Inference parameters for evaluation (greedy decoding)\n",
        "eval_sampling_params = SamplingParams(temperature=0.0, max_tokens=100)\n",
        "\n",
        "def normalize_example(ex, dataset_name):\n",
        "    norm_ex = {'question': '', 'options': {}, 'context': '', 'reference': ''}\n",
        "    dataset_name_lower = dataset_name.lower()\n",
        "\n",
        "    if 'headqa' in dataset_name_lower:\n",
        "        data = ex.get('data', {})\n",
        "        norm_ex['question'] = data.get('Question', '')\n",
        "        norm_ex['options'] = data.get('Options', {})\n",
        "        norm_ex['reference'] = str(data.get('Correct Option', ''))\n",
        "    elif 'medmcqa' in dataset_name_lower:\n",
        "        norm_ex['question'] = ex.get('question', '')\n",
        "        norm_ex['options'] = {\n",
        "            'A': ex.get('opa', ''),\n",
        "            'B': ex.get('opb', ''),\n",
        "            'C': ex.get('opc', ''),\n",
        "            'D': ex.get('opd', '')\n",
        "        }\n",
        "        cop = ex.get('cop', -1)\n",
        "        if cop == 0: norm_ex['reference'] = 'A'\n",
        "        elif cop == 1: norm_ex['reference'] = 'B'\n",
        "        elif cop == 2: norm_ex['reference'] = 'C'\n",
        "        elif cop == 3: norm_ex['reference'] = 'D'\n",
        "        else: norm_ex['reference'] = str(cop)\n",
        "    elif 'medcalc' in dataset_name_lower:\n",
        "        norm_ex['question'] = ex.get('Question', '')\n",
        "        norm_ex['context'] = ex.get('Patient Note', '')\n",
        "        norm_ex['reference'] = str(ex.get('Ground Truth Answer', ''))\n",
        "    elif 'medec' in dataset_name_lower:\n",
        "        norm_ex['question'] = \"Identify the error sentence ID in the text.\"\n",
        "        norm_ex['context'] = ex.get('text', '') + \"\\n\" + ex.get('sentences', '')\n",
        "        norm_ex['reference'] = str(ex.get('error_sentence_id', ''))\n",
        "    else:\n",
        "        norm_ex['question'] = ex.get('question', ex.get('Question', ''))\n",
        "        norm_ex['options'] = ex.get('options', ex.get('Options', {}))\n",
        "        norm_ex['context'] = ex.get('context', ex.get('Context', ''))\n",
        "        norm_ex['reference'] = str(ex.get('answer_idx', ex.get('answer', ex.get('reference', ''))))\n",
        "\n",
        "    return norm_ex\n",
        "\n",
        "def extract_answer(prediction, reference, dataset_name):\n",
        "    r_str = str(reference).strip()\n",
        "    p_str = str(prediction).strip()\n",
        "\n",
        "    if not r_str:\n",
        "        return \"\"\n",
        "\n",
        "    dataset_name_lower = dataset_name.lower()\n",
        "\n",
        "    # Veri setine özel regex kuralları\n",
        "    if any(name in dataset_name_lower for name in ['medqa', 'medmcqa', 'medcalc', 'medec']):\n",
        "        # Genellikle A, B, C, D formatındadır. 'Option A', 'Choice A' gibi başlıkları yakala\n",
        "        match = re.search(rf'^(?:Option\\s+|Choice\\s+|Answer\\s*:?\\s*)?({re.escape(r_str)})\\b', p_str, re.IGNORECASE)\n",
        "        if match and match.group(1).upper() == r_str.upper():\n",
        "            return r_str\n",
        "\n",
        "        # Eğer referans tek harfliyse (örn. A, B, C), büyük/küçük harf duyarlı ara ki 'a' (bir) kelimesi ile karışmasın\n",
        "        if len(r_str) == 1 and r_str.isalpha():\n",
        "            match = re.search(rf'\\b({re.escape(r_str)})\\b', p_str[:30]) # re.IGNORECASE YOK\n",
        "        else:\n",
        "            match = re.search(rf'\\b({re.escape(r_str)})\\b', p_str[:30], re.IGNORECASE)\n",
        "\n",
        "        if match:\n",
        "            return r_str\n",
        "\n",
        "    elif any(name in dataset_name_lower for name in ['headqa', 'medbullets']):\n",
        "        # Genellikle 1, 2, 3, 4, 5 formatındadır.\n",
        "        match = re.search(rf'^(?:Option\\s+|Choice\\s+|Answer\\s*:?\\s*)?({re.escape(r_str)})\\b', p_str, re.IGNORECASE)\n",
        "        if match:\n",
        "            return r_str\n",
        "        match = re.search(rf'\\b({re.escape(r_str)})\\b', p_str[:30], re.IGNORECASE)\n",
        "        if match:\n",
        "            return r_str\n",
        "\n",
        "    elif 'pqa' in dataset_name_lower or 'medhallu' in dataset_name_lower:\n",
        "        # 'yes' veya 'no' yanıtlarını içerebilir\n",
        "        match = re.search(rf'\\b({re.escape(r_str)})\\b', p_str[:50], re.IGNORECASE)\n",
        "        if match:\n",
        "            return r_str\n",
        "\n",
        "    # Hangi veri seti olursa olsun uyan genel kural\n",
        "    if len(r_str) == 1 and r_str.isalpha():\n",
        "        match = re.search(rf'\\b{re.escape(r_str)}\\b', p_str) # case-sensitive\n",
        "    else:\n",
        "        match = re.search(rf'\\b{re.escape(r_str)}\\b', p_str, re.IGNORECASE)\n",
        "\n",
        "    if match:\n",
        "        return r_str\n",
        "\n",
        "    # Hiçbir kural uymazsa, modelin ilk anlamlı çıktısını al\n",
        "    words = re.findall(r'[A-Za-z0-9]+', p_str)\n",
        "    if words:\n",
        "        return words[0]\n",
        "\n",
        "    return p_str[:5]\n",
        "\n",
        "print(\"Starting Benchmark Evaluation (Evaluating all examples per dataset)...\")\n",
        "\n",
        "for file_path, info in tqdm(dataset_mapping.items(), desc=\"Evaluating Datasets\"):\n",
        "    if 'test' not in file_path.lower():\n",
        "        continue\n",
        "\n",
        "    category = info['category']\n",
        "    metrics_to_compute = info['metrics']\n",
        "    dataset_name = os.path.basename(file_path)\n",
        "\n",
        "    data_sample = []\n",
        "    try:\n",
        "        with open(file_path, 'r', encoding='utf-8') as f:\n",
        "            for line in f:\n",
        "                data_sample.append(json.loads(line))\n",
        "    except Exception as e:\n",
        "        print(f\"Error loading {file_path}: {e}\")\n",
        "        continue\n",
        "\n",
        "    if not data_sample:\n",
        "        continue\n",
        "\n",
        "    prompts = []\n",
        "    references = []\n",
        "\n",
        "    is_classification = 'Accuracy' in metrics_to_compute\n",
        "\n",
        "    for ex in data_sample:\n",
        "        norm_ex = normalize_example(ex, dataset_name)\n",
        "        if is_classification:\n",
        "            prompts.append(format_mcq_prompt(norm_ex))\n",
        "            references.append(norm_ex['reference'])\n",
        "        else:\n",
        "            prompts.append(format_generation_prompt(norm_ex))\n",
        "            references.append(norm_ex['reference'])\n",
        "\n",
        "    outputs = llm.generate(prompts, eval_sampling_params, use_tqdm=False)\n",
        "    predictions = [out.outputs[0].text.strip() for out in outputs]\n",
        "\n",
        "    result_dict = {\n",
        "        'Dataset': dataset_name,\n",
        "        'Category': category\n",
        "    }\n",
        "\n",
        "    if is_classification:\n",
        "        extracted_preds = [extract_answer(p, r, dataset_name) for p, r in zip(predictions, references)]\n",
        "        # Optional: Print first 3 comparisons for debugging\n",
        "        # print(f\"\\n--- {dataset_name} ---\")\n",
        "        # for p_raw, p_ext, r in list(zip(predictions, extracted_preds, references))[:3]:\n",
        "        #     print(f\"Ref: {r} | Raw Pred: {p_raw[:30]}... | Extracted: {p_ext}\")\n",
        "\n",
        "        metrics = calculate_classification_metrics(references, extracted_preds)\n",
        "        result_dict.update(metrics)\n",
        "    else:\n",
        "        cleaned_refs = [r if r.strip() else \"empty reference\" for r in references]\n",
        "        cleaned_preds = [p if p.strip() else \"empty prediction\" for p in predictions]\n",
        "        metrics = calculate_generation_metrics(cleaned_refs, cleaned_preds)\n",
        "        result_dict.update(metrics)\n",
        "\n",
        "    results_list.append(result_dict)\n",
        "\n",
        "print(\"\\nEvaluation Complete!\")\n"
      ],
      "execution_count": 22,
