      "source": [
        "print(\"Evaluating MedMCQA Validation Set...\")\n",
        "\n",
        "val_file_path = '/content/drive/MyDrive/biomedical_datasets/Clinical Decision Support/medmcqa_validation.jsonl'\n",
        "dataset_name = 'medmcqa_validation.jsonl'\n",
        "category = 'Clinical Decision Support'\n",
        "\n",
        "data_sample = []\n",
        "try:\n",
        "    with open(val_file_path, 'r', encoding='utf-8') as f:\n",
