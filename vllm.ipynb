        "## Implement Evaluation Metrics\n",
        "\n",
        "### Subtask:\n",
        "Install required metric libraries and implement functions to calculate Accuracy, F1 Score, ROUGE, and BERTScore.\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "8dcce75a"
      },
      "source": [
        "**Reasoning**:\n",
        "Install the necessary evaluation libraries to compute ROUGE and BERTScore metrics.\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "6de6ce58"
      },
      "source": [
        "!pip install rouge-score bert-score -q"
      ],
      "execution_count": 2,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "caaf6546"
      },
      "source": [
        "**Reasoning**:\n",
        "Implement functions to calculate classification and generation metrics using sklearn, rouge_score, and bert_score.\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "29d6bb41",
        "outputId": "05c1145c-911f-418d-c225-a54d1428463e"
      },
      "source": [
        "from sklearn.metrics import accuracy_score, f1_score\n",
        "from rouge_score import rouge_scorer\n",
        "from bert_score import BERTScorer\n",
        "import numpy as np\n",
        "\n",
        "def calculate_classification_metrics(true_labels, predictions):\n",
        "    accuracy = accuracy_score(true_labels, predictions)\n",
        "    f1 = f1_score(true_labels, predictions, average='macro')\n",
        "    return {'Accuracy': accuracy, 'F1 Score': f1}\n",
        "\n",
        "def calculate_generation_metrics(references, candidates):\n",
        "    # ROUGE scorer\n",
        "    scorer = rouge_scorer.RougeScorer(['rougeL'], use_stemmer=True)\n",
        "    rouge_scores = [scorer.score(ref, cand)['rougeL'].fmeasure for ref, cand in zip(references, candidates)]\n",
        "    avg_rouge = np.mean(rouge_scores) if rouge_scores else 0.0\n",
        "\n",
        "    # BERTScorer\n",
        "    bert_scorer = BERTScorer(model_type='distilbert-base-uncased')\n",
        "    P, R, F1 = bert_scorer.score(candidates, references)\n",
        "    avg_bertscore = F1.mean().item() if len(F1) > 0 else 0.0\n",
        "\n",
        "    return {'ROUGE': avg_rouge, 'BERTScore': avg_bertscore}\n",
        "\n",
        "print(\"Evaluation metric functions defined.\")"
      ],
      "execution_count": 4,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Evaluation metric functions defined.\n"
          ]
        }
      ]
    },
