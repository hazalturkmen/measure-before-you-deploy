        "# 1. Install vLLM (This may take a minute)\n",
        "!pip install vllm -q\n",
        "\n",
        "import os\n",
        "# Set vLLM's specific environment variable for multiprocessing\n",
        "os.environ[\"VLLM_WORKER_MULTIPROC_METHOD\"] = \"spawn\"\n",
        "\n",
        "import torch\n",
        "import multiprocessing\n",
        "\n",
        "# Set multiprocessing start method to spawn BEFORE checking CUDA\n",
        "try:\n",
        "    multiprocessing.set_start_method('spawn', force=True)\n",
        "except RuntimeError:\n",
        "    pass\n",
        "\n",
        "# Check if GPU is available\n",
        "if not torch.cuda.is_available():\n",
        "    print(\"🛑 No GPU detected. vLLM requires a GPU to run.\")\n",
        "    print(\"Please go to Runtime -> Change runtime type and select a GPU (e.g., T4, L4, or A100).\")\n",
        "else:\n",
        "    from vllm import LLM, SamplingParams\n",
        "\n",
        "    # 2. Define your model (Using Phi-4 or a TurkSLM as an example)\n",
        "    model_name = \"BioMistral/BioMistral-7B\" # Changed to BioMistral\n",
        "\n",
        "    # 3. Initialize the LLM without quantization\n",
        "    # dtype=\"auto\" will automatically use BF16 if the GPU supports it (A100/L4)\n",
        "    # or FP16 (T4). This is the \"native\" non-quantized state.\n",
        "    llm = LLM(\n",
        "        model=model_name,\n",
        "        dtype=\"auto\",\n",
        "        trust_remote_code=True,\n",
        "        gpu_memory_utilization=0.90, # Reserves 90% of VRAM for the model and KV cache\n",
        "        enforce_eager=True # Sometimes helps in Colab environments\n",
        "    )\n",
        "\n",
        "    # 4. Set up inference parameters\n",
        "    sampling_params = SamplingParams(\n",
        "        temperature=0.7,\n",
        "        top_p=0.95,\n",
        "        max_tokens=256\n",
        "    )\n",
        "\n",
        "    # 5. Run a test prompt\n",
        "    prompts = [\"Hastanın tıbbi geçmişini özetleyin:\"]\n",
        "    outputs = llm.generate(prompts, sampling_params)\n",
        "\n",
        "    # 6. Print the results\n",
        "    for output in outputs:\n",
        "        prompt = output.prompt\n",
        "        generated_text = output.outputs[0].text\n",
        "        print(f\"Prompt: {prompt}\\nGenerated text: {generated_text}\")"
      ]
