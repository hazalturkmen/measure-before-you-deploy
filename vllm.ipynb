      "source": [
        "# Zero-Shot Prompting Example for BioMistral\n",
        "# In zero-shot prompting, we ask the model to perform a task directly without giving it any examples.\n",
        "# Since BioMistral is a medical model, we'll use a medical context.\n",
        "\n",
        "zero_shot_prompts = [\n",
        "    \"What are the most common symptoms of Type 2 Diabetes? Please list them clearly.\"\n",
        "]\n",
        "\n",
        "# Run the prompt using the existing vLLM model and sampling parameters\n",
        "print(\"Running zero-shot prompt...\")\n",
        "zero_shot_outputs = llm.generate(zero_shot_prompts, sampling_params)\n",
        "\n",
        "# Print the results\n",
        "for output in zero_shot_outputs:\n",
        "    prompt = output.prompt\n",
        "    generated_text = output.outputs[0].text.strip()\n",
        "    print(\"\\n--- Zero-Shot Prompt ---\")\n",
        "    print(prompt)\n",
        "    print(\"\\n--- Model Response ---\")\n",
        "    print(generated_text)\n"
      ],
